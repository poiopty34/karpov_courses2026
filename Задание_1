   "source": [
    "import pandas as pd\n",
    "\n",
    "def retention_count(reg_path, auth_path, sep=';'):\n",
    "\n",
    "    reg_data = pd.read_csv(reg_path, sep=sep)\n",
    "    auth_data = pd.read_csv(auth_path, sep=sep)\n",
    "    total_users = reg_data.uid.nunique()\n",
    "    full = pd.merge(auth_data, reg_data, on='uid', how='left')\n",
    "    full['reg_dt'] = pd.to_datetime(full['reg_ts'], unit='s')\n",
    "    full['auth_dt'] = pd.to_datetime(full['auth_ts'], unit='s')\n",
    "    full['days_diff'] = (full['auth_dt'] - full['reg_dt']).dt.days\n",
    "    final = full.groupby(['days_diff'], as_index=False).uid.nunique()\n",
    "    final['retention'] = round(final['uid']/total_users*100, 2)\n",
    "    final = final.sort_values('days_diff')\n",
    "    return final\n"
   ]
  },
